---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const products = await getCollection('productos');
  return products.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;

// 1. RECUPERAMOS LOS DATOS
const { 
    title,       
    pageTitle,   
    price, description, image, 
    sizes, customSizes, 
    colors, customColors, 
    gallery1, gallery2, gallery3, stockStatus = 'En Stock',
    seoTitle, seoDescription 
} = entry.data;

// --- LÓGICA: QUÉ TÍTULO USAR DÓNDE ---
const browserTitle = seoTitle ? seoTitle : `${title} | Siempre Divinas`;
const browserDescription = seoDescription ? seoDescription : description;

// --- MEZCLA DE TALLAS Y COLORES (CORREGIDO) ---
function processOptions(input) {
    if (!input) return [];
    if (typeof input === 'string') {
        return input.split(',').map(item => item.trim()).filter(item => item !== '');
    }
    if (Array.isArray(input)) {
        return input;
    }
    return [];
}

const mainSizesList = processOptions(sizes);
const mainColorsList = processOptions(colors);
const customSizesList = processOptions(customSizes);
const customColorsList = processOptions(customColors);

const finalSizes = [...new Set([...mainSizesList, ...customSizesList])];
const finalColors = [...new Set([...mainColorsList, ...customColorsList])];


const siteUrl = Astro.site ? Astro.site.toString() : 'https://siempredivinas.com';
const imageUrl = new URL(image, siteUrl).toString();
const productUrl = new URL(Astro.url.pathname, siteUrl).toString();

const schemaImages = [imageUrl];
if (gallery1) schemaImages.push(new URL(gallery1, siteUrl).toString());
if (gallery2) schemaImages.push(new URL(gallery2, siteUrl).toString());
if (gallery3) schemaImages.push(new URL(gallery3, siteUrl).toString());

const availabilitySchema = stockStatus === 'Agotado' 
    ? "https://schema.org/OutOfStock" 
    : "https://schema.org/InStock";

const productSchema = JSON.stringify({
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": title,
  "image": schemaImages,
  "description": description,
  "sku": entry.slug,
  "brand": { "@type": "Brand", "name": "Siempre Divinas" },
  "offers": {
    "@type": "Offer",
    "url": productUrl,
    "priceCurrency": "EUR",
    "price": price,
    "availability": availabilitySchema,
    "itemCondition": "https://schema.org/NewCondition",
    "seller": { "@type": "Organization", "name": "Siempre Divinas" }
  }
});

const allCategories = await getCollection('categorias');
const allSubcategories = await getCollection('subcategorias');

const productCategoryNames = entry.data.category
  ? (Array.isArray(entry.data.category) ? entry.data.category : [entry.data.category])
  : [];

const productSubcategoryNames = entry.data.subcategory
  ? (Array.isArray(entry.data.subcategory) ? entry.data.subcategory : [entry.data.subcategory])
  : [];

const matchedCategory = allCategories.find(cat =>
  productCategoryNames.includes(cat.data.title) || productCategoryNames.includes(cat.slug)
);

const matchedSubcategory = allSubcategories.find(sub =>
  productSubcategoryNames.includes(sub.data.title) || productSubcategoryNames.includes(sub.slug)
);

const breadcrumbItems = [];
if (matchedCategory) {
  breadcrumbItems.push({ name: matchedCategory.data.title, url: `/categorias/${matchedCategory.slug}` });
}
if (matchedSubcategory) {
  breadcrumbItems.push({ name: matchedSubcategory.data.title, url: `/subcategorias/${matchedSubcategory.slug}` });
}
breadcrumbItems.push({ name: pageTitle || title });
const allProducts = await getCollection('productos');
const relatedProducts = allProducts.filter(p => p.slug !== entry.slug).slice(0, 3);

const isAgotado = stockStatus === 'Agotado';
const isLastUnits = stockStatus === 'Últimas Unidades';
---

<Layout title={browserTitle} description={browserDescription} image={image} schema={productSchema}>
  
  <main class="container mx-auto px-4 py-12">
    <Breadcrumbs items={breadcrumbItems} />

    <div class="grid md:grid-cols-2 gap-12">
        {/* === ZONA DE IMÁGENES === */}
        <div class="space-y-4 relative">
            
            {isAgotado && (
                <div class="absolute top-4 left-4 z-10 bg-red-600 text-white px-4 py-2 font-bold uppercase tracking-wider shadow-lg rounded">
                    🚫 Agotado
                </div>
            )}
            {isLastUnits && (
                <div class="absolute top-4 left-4 z-10 bg-orange-500 text-white px-4 py-2 font-bold uppercase tracking-wider shadow-lg rounded animate-pulse">
                    🔥 Últimas Unidades
                </div>
            )}
            {!isAgotado && (
                <div class="auto-agotado-ribbon hidden absolute top-4 left-4 z-10 bg-red-600 text-white px-4 py-2 font-bold uppercase tracking-wider shadow-lg rounded">
                    🚫 Agotado
                </div>
            )}

            <img src={image} alt={title} class={`w-full rounded-lg shadow-lg object-cover aspect-[3/4] ${isAgotado ? 'opacity-75 grayscale' : ''}`} id="mainImage"/>
            
            <div class="grid grid-cols-4 gap-2">
                <img src={image} alt={`Vista principal de ${title}`} class="w-full h-24 object-cover rounded cursor-pointer opacity-70 hover:opacity-100 transition border hover:border-pink-brand" onclick="document.getElementById('mainImage').src = this.src" />
                {gallery1 && <img src={gallery1} alt={`Vista detalle 1 de ${title}`} class="w-full h-24 object-cover rounded cursor-pointer opacity-70 hover:opacity-100 transition border hover:border-pink-brand" onclick="document.getElementById('mainImage').src = this.src" />}
                {gallery2 && <img src={gallery2} alt={`Vista detalle 2 de ${title}`} class="w-full h-24 object-cover rounded cursor-pointer opacity-70 hover:opacity-100 transition border hover:border-pink-brand" onclick="document.getElementById('mainImage').src = this.src" />}
                {gallery3 && <img src={gallery3} alt={`Vista detalle 3 de ${title}`} class="w-full h-24 object-cover rounded cursor-pointer opacity-70 hover:opacity-100 transition border hover:border-pink-brand" onclick="document.getElementById('mainImage').src = this.src" />}
            </div>
        </div>

        {/* === ZONA DE INFORMACIÓN Y COMPRA === */}
        <div>
            <h1 class="text-4xl font-serif font-bold text-gray-900 mb-2">{pageTitle || title}</h1>
            
            <div class="flex items-center gap-4 mb-6">
                <p class="text-3xl text-gold-600 font-bold">{price}€</p>
                {isAgotado && <span class="text-red-600 font-bold text-sm uppercase border border-red-200 bg-red-50 px-2 py-1 rounded">Sin Stock</span>}
                {isLastUnits && <span class="text-orange-500 font-bold text-sm uppercase border border-orange-200 bg-orange-50 px-2 py-1 rounded">¡Corre que vuelan!</span>}
                {!isAgotado && <span class="auto-sin-stock-badge hidden text-red-600 font-bold text-sm uppercase border border-red-200 bg-red-50 px-2 py-1 rounded">Sin Stock</span>}
            </div>

            <div class="prose text-gray-600 mb-8"><p>{description}</p></div>

            {/* TALLAS */}
            {finalSizes.length > 0 && (
                <div class="mb-6 product-option" data-type="talla">
                    <label class="block text-sm font-bold mb-2 uppercase tracking-wide text-gray-500">Elige tu talla:</label>
                    <div class="flex gap-3 flex-wrap">
                        {finalSizes.map(size => (
                            <label class={`cursor-pointer ${isAgotado ? 'opacity-50 cursor-not-allowed' : ''}`}>
                                <input type="radio" name="size" value={size} disabled={isAgotado} class="peer sr-only" />
                                <div class="min-w-[3rem] px-2 h-12 flex items-center justify-center border-2 border-gray-200 rounded-md font-bold text-gray-500 peer-checked:border-pink-brand peer-checked:text-pink-brand peer-checked:bg-pink-50 hover:border-gray-400 transition">{size}</div>
                            </label>
                        ))}
                    </div>
                </div>
            )}

            {/* COLORES */}
            {finalColors.length > 0 && (
                <div class="mb-8 product-option" data-type="color">
                    <label class="block text-sm font-bold mb-2 uppercase tracking-wide text-gray-500">Elige color:</label>
                    <div class="flex gap-3 flex-wrap">
                        {finalColors.map(color => (
                            <label class={`cursor-pointer ${isAgotado ? 'opacity-50 cursor-not-allowed' : ''}`}>
                                <input type="radio" name="color" value={color} disabled={isAgotado} class="peer sr-only" />
                                <div class="px-4 py-2 border-2 border-gray-200 rounded-full font-medium text-gray-600 peer-checked:border-gold-600 peer-checked:text-gold-600 peer-checked:bg-yellow-50 hover:border-gray-400 transition">{color}</div>
                            </label>
                        ))}
                    </div>
                </div>
            )}

            {/* BOTÓN DE COMPRA */}
            {isAgotado ? (
                <button disabled class="w-full bg-gray-400 text-white font-bold py-4 px-6 rounded-full cursor-not-allowed flex items-center justify-center gap-3">
                    <span class="text-2xl">🚫</span> PRODUCTO AGOTADO
                </button>
            ) : (
                <button id="add-to-cart-btn" class="w-full bg-black hover:bg-gray-800 text-white font-bold py-4 px-6 rounded-full shadow-lg flex items-center justify-center gap-3 transition transform hover:scale-[1.02]">
                    <span class="text-2xl">🛍️</span> AÑADIR A LA CESTA
                </button>
            )}
            
            <div class="mt-4 flex gap-4 text-xs text-gray-500 justify-center">
                <span class="flex items-center gap-1">✅ Envío 48/72h</span>
                <span class="flex items-center gap-1">🔒 Pago Seguro</span>
            </div>
        </div>
    </div>

    {/* === PRODUCTOS RELACIONADOS === */}
    {relatedProducts.length > 0 && (
        <section class="mt-20 border-t pt-10">
            <h3 class="text-2xl font-serif font-bold mb-6 text-center">También te puede gustar</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                {relatedProducts.map(p => (
                    <a href={`/productos/${p.slug}`} class="block group">
                        <div class="overflow-hidden rounded-lg mb-2 relative">
                            {p.data.stockStatus === 'Agotado' && <div class="absolute top-0 right-0 bg-red-600 text-white text-xs px-2 py-1 font-bold">AGOTADO</div>}
                            {p.data.stockStatus === 'Últimas Unidades' && <div class="absolute top-0 right-0 bg-orange-500 text-white text-xs px-2 py-1 font-bold animate-pulse">ÚLTIMAS</div>}
                            
                            <img src={p.data.image} alt={p.data.title} class="w-full aspect-[3/4] object-cover transition duration-500 group-hover:scale-110" loading="lazy" />
                        </div>
                        <p class="font-bold group-hover:text-pink-brand transition">{p.data.title}</p>
                        <p class="text-sm text-gold-600 font-bold">{p.data.price}€</p>
                    </a>
                ))}
            </div>
        </section>
    )}
  </main>

<script define:vars={{ entry, productSlug: entry.slug, initialAgotado: isAgotado }}>
  let stockData = []; // se rellena al cargar la página

  // Normaliza texto para comparar sin que importen mayúsculas/minúsculas ni espacios extra
  function normalize(text) {
    return (text || '').trim().toLowerCase();
  }

  // --- 1. Cargar el stock real de este producto ---
  async function loadStock() {
    try {
      const res = await fetch(`/api/stock/${productSlug}`, { cache: 'no-store' });
      stockData = await res.json();
      updateAvailability();
      checkTotalStock();
      return stockData;
    } catch (err) {
      console.error('No se pudo cargar el stock:', err);
      // Si falla, no bloqueamos nada (mejor pecar de permisivo que romper la venta)
      return stockData;
    }
  }

  // --- Comprobación de stock TOTAL del producto (todas las tallas/colores) ---
  // Si el CMS no lo ha marcado ya como "Agotado" a mano, pero el stock real
  // de TODAS las combinaciones ha llegado a 0, lo marcamos automáticamente.
  function checkTotalStock() {
    if (initialAgotado) return; // el CMS ya lo marca a mano, no hace falta nada más
    if (stockData.length === 0) return; // todavía no hay datos cargados, o el producto no tiene filas de stock

    const totalStock = stockData.reduce((sum, row) => sum + (row.quantity || 0), 0);
    if (totalStock > 0) return; // queda stock en algún sitio, no tocamos nada

    // Mostrar el sello "Agotado" sobre la imagen
    document.querySelectorAll('.auto-agotado-ribbon').forEach(el => el.classList.remove('hidden'));
    // Mostrar el badge "Sin Stock" junto al precio
    document.querySelectorAll('.auto-sin-stock-badge').forEach(el => el.classList.remove('hidden'));

    // Poner la imagen principal en gris
    const mainImg = document.getElementById('mainImage');
    if (mainImg) mainImg.classList.add('opacity-75', 'grayscale');

    // Desactivar el botón de compra
    const btn = document.getElementById('add-to-cart-btn');
    if (btn) {
      btn.disabled = true;
      btn.classList.remove('bg-black', 'hover:bg-gray-800', 'hover:scale-[1.02]');
      btn.classList.add('bg-gray-400', 'cursor-not-allowed');
      btn.innerHTML = '<span class="text-2xl">🚫</span> PRODUCTO AGOTADO';
    }
  }

  // Cantidad exacta para una combinación concreta talla+color
  function getQuantity(size, color) {
    const match = stockData.find(row =>
      normalize(row.size) === normalize(size) && normalize(row.color) === normalize(color)
    );
    return match ? match.quantity : 0;
  }

  // Suma de stock para una talla, sin importar el color (se usa cuando aún no se ha elegido color)
  function getTotalForSize(size) {
    return stockData
      .filter(row => normalize(row.size) === normalize(size))
      .reduce((sum, row) => sum + row.quantity, 0);
  }

  // Suma de stock para un color, sin importar la talla (se usa cuando aún no se ha elegido talla)
  function getTotalForColor(color) {
    return stockData
      .filter(row => normalize(row.color) === normalize(color))
      .reduce((sum, row) => sum + row.quantity, 0);
  }

  // --- 2. Pintar qué tallas/colores están disponibles según lo ya seleccionado ---
  function updateAvailability() {
    if (stockData.length === 0) return; // todavía no ha cargado, o no hay filas de stock

    const sizeInputs = document.querySelectorAll('input[name="size"]');
    const colorInputs = document.querySelectorAll('input[name="color"]');

    const selectedColor = document.querySelector('input[name="color"]:checked')?.value;
    const selectedSize = document.querySelector('input[name="size"]:checked')?.value;

    sizeInputs.forEach(input => {
      const qty = selectedColor
        ? getQuantity(input.value, selectedColor)
        : getTotalForSize(input.value);
      setOptionDisabled(input, qty <= 0);
    });

    colorInputs.forEach(input => {
      const qty = selectedSize
        ? getQuantity(selectedSize, input.value)
        : getTotalForColor(input.value);
      setOptionDisabled(input, qty <= 0);
    });

    updateAddToCartButton();
  }

  // Desactiva visualmente una opción (radio) sin stock
  function setOptionDisabled(input, disabled) {
    input.disabled = disabled;
    const label = input.closest('label');
    if (label) {
      label.classList.toggle('opacity-40', disabled);
      label.classList.toggle('cursor-not-allowed', disabled);
      label.classList.toggle('pointer-events-none', disabled);
    }
    if (disabled && input.checked) {
      input.checked = false;
    }
  }

  // Desactiva el botón de compra si la combinación elegida no tiene stock
  function updateAddToCartButton() {
    const btn = document.getElementById('add-to-cart-btn');
    if (!btn) return;

    const hasSizes = document.querySelector('.product-option[data-type="talla"]');
    const hasColors = document.querySelector('.product-option[data-type="color"]');

    const selectedSize = document.querySelector('input[name="size"]:checked')?.value;
    const selectedColor = document.querySelector('input[name="color"]:checked')?.value;

    if ((hasSizes && !selectedSize) || (hasColors && !selectedColor)) {
      btn.disabled = false;
      btn.classList.remove('opacity-50', 'cursor-not-allowed');
      return;
    }

    const finalSize = selectedSize || 'Única';
    const finalColor = selectedColor || 'Único';
    const qty = getQuantity(finalSize, finalColor);
    btn.disabled = qty <= 0;
    btn.classList.toggle('opacity-50', qty <= 0);
    btn.classList.toggle('cursor-not-allowed', qty <= 0);
  }

  // Recalcular disponibilidad cada vez que el usuario cambia talla o color
  document.querySelectorAll('input[name="size"], input[name="color"]').forEach(input => {
    input.addEventListener('change', updateAvailability);
  });

  loadStock();
  setInterval(loadStock, 15000); // vuelve a consultar el stock cada 15 segundos (por si la deja abierta un rato)

  // --- 3. Lógica del carrito, con comprobación de stock EN EL MOMENTO del click ---
  const btn = document.getElementById('add-to-cart-btn');

  if (btn) {
      btn.addEventListener('click', async () => {
          const sizeInput = document.querySelector('input[name="size"]:checked');
          const colorInput = document.querySelector('input[name="color"]:checked');

          const hasSizes = document.querySelector('.product-option[data-type="talla"]');
          if (hasSizes && !sizeInput) {
              alert('⚠️ Por favor, selecciona una TALLA antes de añadir.');
              return;
          }

          const hasColors = document.querySelector('.product-option[data-type="color"]');
          if (hasColors && !colorInput) {
              alert('⚠️ Por favor, selecciona un COLOR antes de añadir.');
              return;
          }

          const sizeValue = sizeInput ? sizeInput.value : 'Única';
          const colorValue = colorInput ? colorInput.value : 'Único';

          btn.disabled = true;
          const originalText = btn.innerHTML;
          btn.innerHTML = 'Comprobando stock...';

          await loadStock();

          const qtyNow = getQuantity(sizeValue, colorValue);

          btn.innerHTML = originalText;

          if (qtyNow <= 0) {
              alert('😔 Lo sentimos, esta combinación se acaba de agotar. Prueba con otra talla o color.');
              updateAvailability();
              return;
          }

          const cartItem = {
              id: entry.slug + '-' + sizeValue + '-' + colorValue,
              title: entry.data.title,
              price: entry.data.price,
              image: entry.data.image,
              size: sizeValue,
              color: colorValue,
              quantity: 1
          };

          let cart = JSON.parse(localStorage.getItem('cart') || '[]');
          const existingItemIndex = cart.findIndex(item => item.id === cartItem.id);

          if (existingItemIndex > -1) {
              cart[existingItemIndex].quantity += 1;
          } else {
              cart.push(cartItem);
          }

          localStorage.setItem('cart', JSON.stringify(cart));

          window.dispatchEvent(new Event('cart-updated'));
          window.dispatchEvent(new Event('toggle-cart'));

          btn.disabled = false;
      });
  }
</script>
</Layout>
